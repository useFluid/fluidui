{
  "name": "fluid-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "registry"
  ],
  "scripts": {
    "dev": "npm run dev -w @usefluid/site",
    "build": "npm run build -w @usefluid/site",
    "typecheck": "tsc --noEmit -p packages/motion && tsc --noEmit -p apps/site",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @usefluid/site",
    "new": "node scripts/new-piece.mjs",
    "record": "node scripts/record.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.64.1",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
